        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "genericName": {
                    "nullable": true,
                    "type": "string",
                    "maxLength": 255
                  },
                  "strength": {
                    "nullable": true,
                    "type": "string",
                    "maxLength": 255
                  },
                  "dosageForm": {
                    "nullable": true,
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "INACTIVE",
                      "ARCHIVED"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  }
                },
                "required": [
                  "name",
                  "genericName",
                  "strength",
                  "dosageForm",
                  "status",
                  "source"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
